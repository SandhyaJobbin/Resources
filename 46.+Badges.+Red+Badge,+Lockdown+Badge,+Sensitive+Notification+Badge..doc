<body>
    <h1>46. Badges. Red Badge, Lockdown Badge, Sensitive Notification Badge=
.</h1>
    <div class=3D"Section1">
        <h1 id=3D"id-46.Badges.RedBadge,LockdownBadge,SensitiveNotification=
Badge.-Overview">
<style>[data-colorid=3Duhahnuml69]{color:#0e101a} html[data-color-mode=3Dda=
